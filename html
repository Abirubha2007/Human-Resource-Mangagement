<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Dayflow | Login</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background: #ffffff;
      color: #111111;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 1100px;
      min-height: 650px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      border: 1px solid #e5e5e5;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    }

    /* LEFT SIDE */

    .left {
      padding: 60px;
      background: #fafafa;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .logo span {
      display: block;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 3px;
      color: #666;
      margin-top: 4px;
    }

    .hero {
      margin-top: 40px;
    }

    .hero h1 {
      font-size: 48px;
      line-height: 1.05;
      letter-spacing: -2px;
      margin-bottom: 20px;
    }

    .hero h1 span {
      font-weight: 400;
    }

    .hero p {
      max-width: 430px;
      color: #666;
      font-size: 16px;
      line-height: 1.7;
    }

    .features {
      display: flex;
      gap: 25px;
      margin-top: 45px;
    }

    .feature {
      flex: 1;
    }

    .feature-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: #111;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }

    .feature h3 {
      font-size: 15px;
      margin-bottom: 5px;
    }

    .feature p {
      font-size: 12px;
      line-height: 1.5;
      color: #777;
    }

    .copyright {
      color: #888;
      font-size: 12px;
    }

    /* RIGHT SIDE */

    .right {
      background: white;
      padding: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-box {
      width: 100%;
      max-width: 390px;
    }

    .user-icon {
      width: 65px;
      height: 65px;
      background: #111;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin-bottom: 25px;
    }

    .login-box h2 {
      font-size: 34px;
      letter-spacing: -1px;
      margin-bottom: 8px;
    }

    .subtitle {
      color: #777;
      margin-bottom: 35px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .input-box {
      position: relative;
    }

    .input-box input {
      width: 100%;
      height: 52px;
      padding: 0 45px 0 16px;
      border: 1px solid #dcdcdc;
      border-radius: 12px;
      outline: none;
      font-size: 14px;
      transition: 0.3s;
    }

    .input-box input:focus {
      border-color: #111;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
    }

    .input-icon {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #777;
    }

    .options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 5px 0 25px;
      font-size: 13px;
    }

    .remember {
      display: flex;
      gap: 7px;
      align-items: center;
    }

    .options a {
      color: #111;
      font-weight: 600;
      text-decoration: underline;
    }

    .login-btn {
      width: 100%;
      height: 54px;
      border: none;
      border-radius: 12px;
      background: #111;
      color: white;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.3s;
    }

    .login-btn:hover {
      background: #333;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .demo {
      margin-top: 25px;
      padding: 18px;
      border: 1px solid #e5e5e5;
      border-radius: 14px;
      background: #fafafa;
      font-size: 13px;
      line-height: 1.8;
    }

    .demo strong {
      display: block;
      margin-bottom: 5px;
    }

    .signup {
      text-align: center;
      margin-top: 25px;
      font-size: 14px;
      color: #666;
    }

    .signup a {
      color: #111;
      font-weight: 700;
      text-decoration: underline;
    }

    .error {
      color: #d00000;
      font-size: 13px;
      margin-top: 8px;
      display: none;
    }

    /* RESPONSIVE */

    @media (max-width: 800px) {
      .container {
        grid-template-columns: 1fr;
        margin: 20px;
      }

      .left {
        display: none;
      }

      .right {
        padding: 40px 25px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <!-- LEFT -->
    <section class="left">

      <div>
        <div class="logo">
          Dayflow
          <span>HRMS</span>
        </div>

        <div class="hero">
          <h1>
            Every workday,
            <span>perfectly aligned.</span>
          </h1>

          <p>
            Manage employees, attendance, leave, payroll
            and workplace operations — all in one place.
          </p>
        </div>

        <div class="features">

          <div class="feature">
            <div class="feature-icon">✓</div>
            <h3>Secure</h3>
            <p>Your workforce data stays protected.</p>
          </div>

          <div class="feature">
            <div class="feature-icon">◆</div>
            <h3>Reliable</h3>
            <p>Built for modern teams and organizations.</p>
          </div>

          <div class="feature">
            <div class="feature-icon">↗</div>
            <h3>Insightful</h3>
            <p>Make better workforce decisions.</p>
          </div>

        </div>
      </div>

      <div class="copyright">
        © 2026 Dayflow. All rights reserved.
      </div>

    </section>


    <!-- RIGHT -->
    <section class="right">

      <div class="login-box">

        <div class="user-icon">♙</div>

        <h2>Welcome back!</h2>

        <p class="subtitle">
          Sign in to your account to continue
        </p>


        <!-- EMAIL -->

        <div class="form-group">

          <label>Email address</label>

          <div class="input-box">

            <input
              type="email"
              id="email"
              placeholder="Enter your email address"
            />

          </div>

          <div class="error" id="emailError">
            Please enter a valid email address.
          </div>

        </div>


        <!-- PASSWORD -->

        <div class="form-group">

          <label>Password</label>

          <div class="input-box">

            <input
              type="password"
              id="password"
              placeholder="Enter your password"
            />

            <span
              class="input-icon"
              onclick="togglePassword()"
              id="eye"
            >
              ◉
            </span>

          </div>

          <div class="error" id="passwordError">
            Password is required.
          </div>

        </div>


        <!-- OPTIONS -->

        <div class="options">

          <label class="remember">
            <input type="checkbox">
            Remember me
          </label>

          <a href="#">
            Forgot password?
          </a>

        </div>


        <!-- LOGIN -->

        <button
          class="login-btn"
          onclick="login()"
        >
          Sign In
        </button>


        <!-- DEMO -->

        <div class="demo">

          <strong>Demo Accounts</strong>

          Admin:
          <b>admin@dayflow.com</b>

          <br>

          Employee:
          <b>employee@dayflow.com</b>

        </div>


        <!-- SIGNUP -->

        <div class="signup">

          Don't have an account?

          <a href="#">
            Create account →
          </a>

        </div>

      </div>

    </section>

  </div>


  <script>

    function togglePassword() {

      const password =
        document.getElementById("password");

      if (password.type === "password") {

        password.type = "text";

      } else {

        password.type = "password";

      }
    }


    function login() {

      const email =
        document.getElementById("email").value.trim();

      const password =
        document.getElementById("password").value.trim();

      const emailError =
        document.getElementById("emailError");

      const passwordError =
        document.getElementById("passwordError");

      emailError.style.display = "none";
      passwordError.style.display = "none";


      if (!email || !email.includes("@")) {

        emailError.style.display = "block";
        return;

      }


      if (!password) {

        passwordError.style.display = "block";
        return;

      }


      if (email === "admin@dayflow.com") {

        alert("Welcome Admin!");

      }

      else if (email === "employee@dayflow.com") {

        alert("Welcome Employee!");

      }

      else {

        alert("Invalid demo account.");

      }

    }

  </script>

</body>
</html>
